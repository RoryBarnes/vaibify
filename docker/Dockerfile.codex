# Vaibify — Codex CLI overlay
#
# Installs Codex using OpenAI's native installer as the unprivileged
# container user. The installer owns the binary below ~/.local/bin, so
# ``codex update`` can replace it without sudo during container startup.

ARG BASE_IMAGE=vaibify:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER ${CONTAINER_USER}

RUN if ! curl -fsSL --retry 3 --retry-connrefused --retry-delay 5 \
            --connect-timeout 30 \
            https://chatgpt.com/codex/install.sh \
            -o /tmp/codex-install.sh; then \
        echo "" >&2; \
        printf '%s\n' "vaibify build (codex overlay): cannot download Codex installer." >&2; \
        printf '%s\n' "  - The installer lives at chatgpt.com/codex/install.sh." >&2; \
        printf '%s\n' "  - Download failed (likely a TLS or network failure between" >&2; \
        printf '%s\n' "    this build host and chatgpt.com)." >&2; \
        printf '%s\n' "Pick one workaround:" >&2; \
        printf '%s\n' "  1. Disable the Codex overlay (features: { codex: false })." >&2; \
        printf '%s\n' "  2. Resolve your build host's network path to chatgpt.com" >&2; \
        printf '%s\n' "     (proxy, IPv6, MTU, TLS inspection) and rebuild." >&2; \
        echo "" >&2; \
        exit 1; \
    fi \
    && if ! bash /tmp/codex-install.sh; then \
        echo "" >&2; \
        printf '%s\n' "vaibify build (codex overlay): Codex installer failed." >&2; \
        printf '%s\n' "  - The installer downloaded successfully but exited non-zero." >&2; \
        printf '%s\n' "  - Re-run the official installer after resolving network access." >&2; \
        echo "" >&2; \
        exit 1; \
    fi \
    && rm -f /tmp/codex-install.sh

ENV PATH="/home/${CONTAINER_USER}/.local/bin:${PATH}"
