# Vaibify — shared Node.js overlay for npm-distributed coding agents

ARG BASE_IMAGE=vaibify:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

RUN (install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL --retry 3 --retry-connrefused --retry-delay 5 \
        --connect-timeout 30 \
        https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        -o /tmp/nodesource.gpg.key \
    && gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg /tmp/nodesource.gpg.key \
    && rm -f /tmp/nodesource.gpg.key \
    && printf '%s\n' \
        'deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main' \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*) \
    || { echo "vaibify build: Node.js installation failed" >&2; exit 1; }

USER ${CONTAINER_USER}

ENV NPM_CONFIG_PREFIX="/home/${CONTAINER_USER}/.local"
ENV PATH="/home/${CONTAINER_USER}/.local/bin:${PATH}"
