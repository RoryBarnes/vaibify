# Vaibify — Gemini CLI overlay
#
# Gemini CLI requires Node.js 20 or newer. Install the signed NodeSource
# Node 20 package as root, then install the CLI under the container user's
# ~/.local prefix so Gemini's built-in auto-update has no root dependency.

ARG BASE_IMAGE=vaibify:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

RUN install -m 0755 -d /etc/apt/keyrings \
    && if ! curl -fsSL --retry 3 --retry-connrefused --retry-delay 5 \
            --connect-timeout 30 \
            https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
            -o /tmp/nodesource.gpg.key; then \
        echo "" >&2; \
        printf '%s\n' "vaibify build (gemini overlay): cannot download NodeSource signing key." >&2; \
        printf '%s\n' "  - Gemini CLI requires Node.js 20 or newer." >&2; \
        printf '%s\n' "  - Resolve this build host's path to deb.nodesource.com and rebuild," >&2; \
        printf '%s\n' "    or disable the Gemini overlay (features: { gemini: false })." >&2; \
        echo "" >&2; \
        exit 1; \
    fi \
    && gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg /tmp/nodesource.gpg.key \
    && rm -f /tmp/nodesource.gpg.key \
    && printf '%s\n' \
        'deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main' \
        > /etc/apt/sources.list.d/nodesource.list \
    && if ! apt-get -o Acquire::Retries=3 update \
        || ! apt-get -o Acquire::Retries=3 install -y --no-install-recommends nodejs; then \
        echo "" >&2; \
        printf '%s\n' "vaibify build (gemini overlay): cannot install Node.js 20." >&2; \
        printf '%s\n' "  - Resolve this build host's path to deb.nodesource.com and rebuild," >&2; \
        printf '%s\n' "    or disable the Gemini overlay (features: { gemini: false })." >&2; \
        echo "" >&2; \
        exit 1; \
    fi \
    && rm -rf /var/lib/apt/lists/*

USER ${CONTAINER_USER}

ENV NPM_CONFIG_PREFIX="/home/${CONTAINER_USER}/.local"
ENV PATH="/home/${CONTAINER_USER}/.local/bin:${PATH}"

RUN if ! npm install --global --fetch-retries=3 @google/gemini-cli; then \
        echo "" >&2; \
        printf '%s\n' "vaibify build (gemini overlay): Gemini CLI install failed." >&2; \
        printf '%s\n' "  - npm could not install @google/gemini-cli." >&2; \
        printf '%s\n' "  - Resolve this build host's path to registry.npmjs.org and rebuild," >&2; \
        printf '%s\n' "    or disable the Gemini overlay (features: { gemini: false })." >&2; \
        echo "" >&2; \
        exit 1; \
    fi
